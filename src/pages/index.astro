  *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:#fff;color:var(--ink);font-family:'DM Sans',Arial,sans-serif;-webkit-font-smoothing:antialiased;line-height:1.5}body.no-scroll{overflow:hidden}::selection{background:#b0f3e8;color:#08212b}a{color:inherit;text-decoration:none}button{font:inherit}svg{display:block}img{max-width:100%;display:block}.container{width:min(calc(100% - 92px),var(--container));margin-inline:auto}.eyebrow{font-size:11px;letter-spacing:.23em;font-weight:800;text-transform:uppercase}.row{display:flex;align-items:center}.hide{display:none!important}
  .site-nav{position:fixed;z-index:200;top:0;left:0;right:0;height:84px;border-bottom:1px solid rgba(255,255,255,.16);color:#f4f8fb;transition:background .25s,color .25s,box-shadow .25s,height .25s}.site-nav.scrolled{height:70px;background:rgba(252,253,254,.96);border-bottom:1px solid #e7ebee;color:#172635;backdrop-filter:blur(14px);box-shadow:0 7px 25px rgba(20,32,45,.045)}.nav-inner{height:100%;display:flex;align-items:center;gap:42px}.brand{display:flex;align-items:center;gap:12px;flex-shrink:0}.brand-symbol{height:40px;width:40px;display:grid;place-items:center;position:relative;border:1px solid currentColor;border-radius:50%;opacity:.9}.brand-symbol:before{content:'';width:25px;height:25px;border:1.6px solid currentColor;border-radius:50%;position:absolute;transform:rotate(25deg) scaleX(.38)}.brand-symbol:after{content:'';width:28px;height:28px;border:1.6px solid currentColor;border-radius:50%;position:absolute;transform:rotate(-36deg) scaleX(.5)}.brand-text{display:flex;flex-direction:column;line-height:1.12}.brand-text strong{font:800 21px 'Manrope',Arial,sans-serif;letter-spacing:-.07em}.brand-text small{font-size:8.3px;letter-spacing:.095em;margin-top:5px;opacity:.82}.nav-links{display:flex;gap:27px;align-items:center;margin-left:auto;font-size:12px;font-weight:700}.nav-links a:not(.nav-cta){opacity:.85;transition:opacity .15s}.nav-links a:hover{opacity:1;color:#51c9bc}.site-nav.scrolled .nav-links a:hover{color:#0b9f94}.nav-cta{border:1px solid rgba(255,255,255,.5);border-radius:5px;padding:12px 16px;white-space:nowrap}.site-nav.scrolled .nav-cta{background:#101e29;color:#fff;border-color:#101e29}.nav-toggle{display:none;background:transparent;border:0;color:inherit;margin-left:auto;padding:8px}.progress{position:fixed;z-index:210;left:0;top:0;width:0;height:3px;background:#52e0cc;transition:width .08s linear}
  .hero{min-height:865px;height:100svh;max-height:1100px;position:relative;background:#081521;color:#fff;overflow:hidden;display:flex;align-items:center}.hero:before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 68% 46%,#173b50 0,transparent 36%),linear-gradient(100deg,#06121b 5%,#092231 50%,#0e283b);opacity:.82}.hero:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(5,15,24,.94) 1%,rgba(5,15,24,.88) 30%,rgba(5,15,24,.26) 73%,rgba(5,15,24,.18) 100%);pointer-events:none}.hero-robot{position:absolute;right:-6%;top:9%;width:89%;max-width:1400px;height:93%;object-fit:contain;opacity:.84;filter:drop-shadow(0 30px 90px rgba(10,241,203,.09))}.hero-content{position:relative;z-index:2;width:100%;padding-top:66px}.hero-kicker{color:#80dad0;display:flex;gap:15px;align-items:center;margin-bottom:35px}.hero-kicker:before{content:'';width:35px;height:1px;background:#76e5d6}.hero h1{font-family:'Manrope',sans-serif;font-size:clamp(57px,6.75vw,112px);font-weight:700;letter-spacing:-.075em;line-height:1.105;max-width:860px;margin:0 0 35px}.hero h1 em{font-style:normal;color:#79e1d6}.hero-lead{font-size:clamp(16px,1.35vw,21px);line-height:1.75;color:#cad6df;max-width:570px;margin:0 0 38px;font-weight:400}.hero-actions{display:flex;align-items:center;gap:18px}.button-primary{background:#7fe3d6;border:1px solid #7fe3d6;color:#07232c;padding:16px 25px;font-size:13px;font-weight:800;border-radius:3px;display:inline-flex;align-items:center;gap:26px;transition:transform .2s,background .2s}.button-primary:hover{transform:translateY(-3px);background:#a5f1e6}.button-text{font-size:13px;font-weight:700;color:#eef5f8;padding:14px 10px}.button-text span{margin-left:10px}.hero-bottom{position:absolute;bottom:42px;left:0;right:0;z-index:3;display:flex;justify-content:space-between;color:#91a8b8;align-items:flex-end}.hero-bottom .hero-code{font-size:11px;letter-spacing:.1em;text-transform:uppercase;line-height:1.8}.scroll-label{display:flex;gap:13px;align-items:center;font-size:11px;font-weight:700;letter-spacing:.2em;text-transform:uppercase}.scroll-icon{height:46px;width:26px;border:1px solid rgba(200,244,239,.5);border-radius:14px;display:flex;justify-content:center;padding:8px}.scroll-icon:after{content:'';height:9px;width:3px;border-radius:2px;background:#83e6d7;animation:scroll-cue 1.7s infinite}@keyframes scroll-cue{0%{transform:translateY(0);opacity:0}40%{opacity:1}100%{transform:translateY(16px);opacity:0}}
