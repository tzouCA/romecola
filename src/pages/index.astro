<body>
  <div class="progress" id="scrollProgress"></div>
  <header class="site-nav" id="nav">
    <div class="container nav-inner">
      <a class="brand" href="#home" aria-label="RoMeCoLa homepage"><span class="brand-symbol" aria-hidden="true"></span><span class="brand-text"><strong>RoMeCoLa</strong><small>ROBOTICS · MECHANICS · CONTROL</small></span></a>
      <button class="nav-toggle" id="navToggle" aria-label="Open navigation" aria-expanded="false">☰</button>
      <nav class="nav-links" id="navLinks" aria-label="Primary navigation"><a href="#about">About</a><a href="#research">Research</a><a href="#publications">Publications</a><a href="#lab">The Lab</a><a href="#people">People</a><a href="#contact">Contact</a><a class="nav-cta" href="#join">Join our lab ↗</a></nav>
    </div>
  </header>
  <main>
    <section class="hero" id="home" aria-label="Homepage introduction">
      <img class="hero-robot" src="assets/hero-robot.svg" alt="Conceptual illustration of a legged robot with a manipulator">
      <div class="container hero-content">
        <div class="hero-kicker eyebrow">Memorial University of Newfoundland · Canada</div>
        <h1>Intelligence<br>that moves<br><em>the world.</em></h1>
        <p class="hero-lead">We develop intelligent robotic systems that learn, adapt, and interact with the physical world — from bio-inspired flight to embodied AI and autonomous industrial operations.</p>
        <div class="hero-actions"><a class="button-primary" href="#research">Explore our research <span>↗</span></a><a class="button-text" href="#about">Meet RoMeCoLa <span>→</span></a></div>
      </div>
      <div class="container hero-bottom"><div class="hero-code">Research at the intersection of<br>design × learning × control</div><a class="scroll-label" href="#about">Scroll to explore <span class="scroll-icon" aria-hidden="true"></span></a></div>
    </section>
