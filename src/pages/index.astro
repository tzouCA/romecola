  .people{background:#fff}.people-feature{display:grid;grid-template-columns:310px minmax(0,1fr);gap:56px;align-items:center;margin-bottom:57px}.portrait{aspect-ratio:1;background:linear-gradient(145deg,#c8e6e3,#507d89);display:grid;place-items:center;position:relative;overflow:hidden}.portrait:before{content:'';width:55%;aspect-ratio:1;border:1px solid rgba(248,255,255,.4);border-radius:50%;position:absolute;transform:scale(2)}.portrait:after{content:'';width:55%;aspect-ratio:1;border:1px solid rgba(248,255,255,.23);border-radius:50%;position:absolute;transform:scale(2.8)}.portrait span{position:relative;z-index:2;font:700 80px 'Manrope';letter-spacing:-.09em;color:#e8ffff}.people-feature small,.member small{font-size:11px;color:#079d94;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.people-feature h3{font:700 38px 'Manrope';letter-spacing:-.05em;margin:12px 0}.people-feature p{font-size:16px;line-height:1.8;color:#60727f;max-width:750px}.people-feature a{font-size:13px;font-weight:700;color:#198c89}.member-heading{font:700 22px 'Manrope';letter-spacing:-.04em;border-top:1px solid #e1e8eb;padding:25px 0;margin:0}.member-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.member{display:flex;gap:20px;align-items:center;border:1px solid #e7ecee;padding:17px}.member-avatar{height:78px;width:78px;flex-shrink:0;background:linear-gradient(135deg,#1a5162,#98dbd2);display:grid;place-items:center;color:#ecfcf9;font:700 28px 'Manrope';letter-spacing:-.05em}.member h4{font:700 15px 'Manrope';margin:4px 0 4px}.member small{font-size:9px}.people-note{font-size:12px;color:#8b97a1;margin-top:22px}
  .join{position:relative;overflow:hidden;background:#062131;color:#fff;padding:122px 0}.join:after{content:'';position:absolute;border:1px solid rgba(123,211,213,.22);border-radius:50%;width:900px;height:900px;right:-280px;top:-300px;box-shadow:0 0 0 110px rgba(47,160,165,.05),0 0 0 230px rgba(47,160,165,.035)}.join-inner{position:relative;z-index:2;display:flex;align-items:flex-end;justify-content:space-between;gap:40px}.join h2{font:700 clamp(47px,6vw,85px)/1.1 'Manrope';letter-spacing:-.07em;margin:10px 0 20px;max-width:800px}.join p{color:#b7d1d6;max-width:630px;font-size:17px;line-height:1.7}.join .section-label{color:#8eece0}.join .section-label:before{background:#8eece0}.join-actions{display:flex;flex-direction:column;gap:13px;align-items:flex-start;min-width:200px}.join-actions .button-primary{white-space:nowrap}.join-actions small{color:#9bc1c8;font-size:11px}
  .footer{background:#06121b;color:#dce8ed;padding:70px 0 25px}.footer-grid{display:grid;grid-template-columns:1.6fr 1fr 1fr;gap:70px;padding-bottom:60px;border-bottom:1px solid #273b45}.footer .brand{margin-bottom:24px}.footer p{font-size:13px;line-height:1.9;color:#9eb4be;max-width:340px}.footer h4{font:800 12px 'Manrope';letter-spacing:.12em;text-transform:uppercase;color:#fff;margin:0 0 20px}.footer .footer-link{display:block;margin:9px 0;color:#abc1cb;font-size:13px}.footer .footer-link:hover{color:#79e1d6}.footer-bottom{display:flex;justify-content:space-between;align-items:center;padding-top:25px;font-size:11px;color:#6e909f}.prototype-alert{display:flex;align-items:center;gap:8px;font-size:10px;letter-spacing:.09em;color:#75a7ab}.prototype-alert:before{content:'';height:6px;width:6px;background:#70e4d2;border-radius:50%}
  .fade-up{opacity:0;transform:translateY(22px);transition:opacity .65s ease,transform .65s ease}.fade-up.visible{opacity:1;transform:none}
  @media(max-width:1100px){.container{width:min(calc(100% - 64px),var(--container))}.nav-links{gap:16px}.nav-inner{gap:16px}.nav-links a{font-size:11px}.hero-robot{right:-15%;width:105%;opacity:.65}.pillar-grid{grid-template-columns:repeat(2,1fr)}.gallery{grid-template-columns:repeat(2,1fr)}.member-grid{grid-template-columns:repeat(2,1fr)}.project{grid-column:span 6}.project.hero-card{grid-column:span 12}.project.wide{grid-column:span 6}}
  @media(max-width:760px){.container{width:calc(100% - 38px)}.site-nav{height:68px}.site-nav.scrolled{height:65px}.brand-symbol{width:33px;height:33px}.brand-text strong{font-size:19px}.brand-text small{font-size:7px}.nav-toggle{display:block;font-size:23px}.nav-links{display:none;position:absolute;top:68px;left:0;right:0;margin:0;background:#091b25;color:#fff;padding:28px 25px 36px;flex-direction:column;align-items:flex-start;gap:24px;box-shadow:0 20px 40px rgba(0,0,0,.2)}.site-nav.scrolled .nav-links{top:65px}.nav-links.open{display:flex}.nav-links a{font-size:15px}.nav-cta{border:1px solid rgba(255,255,255,.4)!important;background:transparent!important;color:#fff!important}.hero{height:auto;min-height:790px;max-height:none;padding-top:120px;padding-bottom:120px}.hero-robot{width:140%;height:70%;right:-68%;top:20%;opacity:.5}.hero:after{background:linear-gradient(90deg,rgba(4,16,25,.95),rgba(4,16,25,.58))}.hero-content{padding-top:20px}.hero h1{font-size:clamp(52px,11vw,79px)}.hero-lead{font-size:16px}.hero-actions{flex-wrap:wrap}.hero-bottom{bottom:28px}.hero-code{display:none}.signal-inner{display:grid;grid-template-columns:1fr 1fr;gap:15px 10px;padding:20px 0;font-size:9px}.signal-inner span:before{font-size:11px;margin-right:7px}.section{padding:85px 0}.section-heading{display:block;margin-bottom:35px}.section-desc{margin-top:24px}.about{padding:105px 0}.about-layout{grid-template-columns:1fr;gap:15px}.about-title{font-size:43px}.about-description{font-size:16px}.about-metric{padding:20px 13px}.about-metric strong{font-size:23px}.pillar-grid{grid-template-columns:repeat(2,1fr);gap:8px;margin-bottom:45px}.pillar{min-height:248px;padding:20px 16px}.pillar h3{font-size:15px}.pillar p{font-size:12px}.research-intro{align-items:flex-start;gap:18px}.research-intro h3{font-size:22px}.research-intro .small-note{text-align:right;max-width:120px}.project-grid{gap:11px}.project,.project.wide,.project.hero-card{grid-column:span 12;min-height:310px;padding:24px}.project h3{font-size:26px}.research-outro{display:block;line-height:1.8}.experience-layout{grid-template-columns:1fr;gap:5px}.experience h2{font-size:43px}.exp-art{height:350px}.exp-art img{width:105%}.pub-item{grid-template-columns:50px 1fr;gap:11px}.pub-action{grid-column:2;text-align:left}.pub-item h3{font-size:16px}.pub-bottom{display:block}.pub-bottom .text-link{display:inline-block;margin-top:21px}.gallery{gap:9px}.gallery-card{height:200px}.gallery-card strong{left:12px;bottom:13px;font-size:11px}.gallery-card small{left:12px;top:12px;font-size:9px}.people-feature{grid-template-columns:1fr;gap:25px}.portrait{width:min(80%,310px)}.people-feature h3{font-size:31px}.member-grid{grid-template-columns:1fr}.join{padding:94px 0}.join-inner{display:block}.join h2{font-size:50px}.join-actions{margin-top:27px}.footer-grid{grid-template-columns:1fr 1fr;gap:40px 30px}.footer-grid>div:first-child{grid-column:span 2}.footer-bottom{gap:15px;flex-wrap:wrap}}
