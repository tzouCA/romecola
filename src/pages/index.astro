  .research{background:#f6f8f9;padding-top:125px}.pillar-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:80px}.pillar{background:#fff;border:1px solid #e9edee;min-height:255px;padding:30px 27px 27px;transition:transform .2s,box-shadow .2s}.pillar:hover{transform:translateY(-4px);box-shadow:0 22px 45px rgba(10,30,45,.08)}.pillar-number{font:700 12px 'Manrope';color:#08a99d;letter-spacing:.14em}.pillar-symbol{font-size:35px;color:#1b8b8a;margin:12px 0 22px}.pillar h3{font:700 18px/1.32 'Manrope';letter-spacing:-.035em;margin:0 0 12px}.pillar p{margin:0;color:#6e7c89;font-size:13px;line-height:1.65}.research-intro{display:flex;justify-content:space-between;align-items:center;margin-bottom:28px}.research-intro h3{font:700 28px 'Manrope';letter-spacing:-.055em;margin:0}.research-intro .small-note{font-size:12px;color:#758592}.project-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:16px}.project{position:relative;min-height:347px;background:#102233;overflow:hidden;grid-column:span 4;color:#fff;isolation:isolate;display:flex;align-items:flex-end;padding:27px;transition:transform .3s ease,box-shadow .3s}.project.wide{grid-column:span 6;min-height:395px}.project.hero-card{grid-column:span 8;min-height:425px}.project:hover{transform:translateY(-5px);box-shadow:0 24px 48px rgba(13,40,57,.16)}.project img.art{position:absolute;z-index:-2;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .65s ease}.project:hover img.art{transform:scale(1.06)}.project:after{content:'';position:absolute;inset:0;z-index:-1;background:linear-gradient(0deg,rgba(4,15,23,.95) 0%,rgba(5,17,28,.48) 47%,rgba(7,20,32,.05) 100%)}.project-label{font-weight:800;font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:#9ae7da;margin-bottom:12px}.project h3{font:700 clamp(21px,2.0vw,31px)/1.23 'Manrope';letter-spacing:-.045em;margin:0 0 11px;max-width:470px}.project p{font-size:13px;line-height:1.5;color:#d5e2e8;margin:0;max-width:530px}.project-num{position:absolute;top:23px;left:28px;font-size:11px;font-weight:800;letter-spacing:.14em;color:#d6eae9;opacity:.85}.project-arrow{position:absolute;right:22px;top:18px;font-size:20px;color:#e8ffff;opacity:.6}.project .project-foot{position:relative;z-index:2}.research-outro{display:flex;align-items:center;justify-content:space-between;padding-top:37px;color:#536a75;font-size:13px}.research-outro strong{color:#1c5663}
  .experience{background:#081722;color:#eff9fb;overflow:hidden}.experience-layout{display:grid;grid-template-columns:1fr 1fr;gap:9%;align-items:center}.experience .section-label{color:#72e2d2}.experience .section-label:before{background:#72e2d2}.experience h2{font-size:clamp(44px,4.85vw,70px);max-width:590px}.experience p{font-size:17px;line-height:1.85;color:#a9c0cd;max-width:540px}.experience .exp-list{margin-top:38px;display:grid;gap:0}.exp-line{display:flex;justify-content:space-between;border-top:1px solid #2d4752;padding:17px 0;font-size:13px;color:#dae8ed;gap:12px}.exp-line span:nth-child(2){color:#83bbbd}.exp-art{height:550px;position:relative;display:grid;place-items:center;background:radial-gradient(circle at 55% 50%,rgba(29,156,148,.23),transparent 55%)}.exp-art img{width:115%;max-width:none;filter:drop-shadow(0 25px 50px rgba(0,0,0,.2))}.exp-art:after{content:'ROBOTICS / REAL WORLD / 2026';position:absolute;right:0;bottom:10px;font-size:10px;letter-spacing:.22em;color:#74b6bc}
  .publications{background:#fff}.pub-list{border-top:1px solid #dbe4e8}.pub-item{display:grid;grid-template-columns:98px minmax(0,1fr) 95px;gap:20px;align-items:start;border-bottom:1px solid #e2e8eb;padding:27px 6px;transition:background .2s}.pub-item:hover{background:#f7fafb}.pub-year{font:700 13px 'Manrope';color:#119e97;margin-top:5px}.pub-item h3{font:700 clamp(17px,1.6vw,22px)/1.44 'Manrope';letter-spacing:-.035em;margin:0 0 10px;max-width:900px}.pub-item p{font-size:12px;color:#71818c;margin:0;line-height:1.6}.pub-action{text-align:right;margin-top:4px;font-size:12px;color:#167e7a;font-weight:800}.pub-action span{margin-left:9px}.pub-bottom{margin-top:35px;display:flex;justify-content:space-between;align-items:center;gap:20px}.pub-bottom p{margin:0;font-size:12px;color:#85939d}.text-link{font-weight:800;font-size:13px;color:#188f8b;border-bottom:1px solid #188f8b;padding-bottom:5px}
